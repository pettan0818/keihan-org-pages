---
import '../styles/global.css';
import { routes, ui, SITE_URL, CONTACT_FORM_URL, jaOnlyRoutes, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  /** Full document title. */
  title: string;
  description: string;
  /** Bilingual page key. Omit for Japanese-only pages and pass `path` instead. */
  route?: RouteKey;
  path?: string;
  ogImage?: string;
}

const { lang, title, description, route, ogImage = '/og.png' } = Astro.props;
const path = route ? routes[route][lang] : (Astro.props.path ?? Astro.url.pathname);
const canonical = new URL(path, SITE_URL).href;
const t = ui[lang];
const otherLang: Lang = lang === 'ja' ? 'en' : 'ja';
const switchHref = route ? routes[route][otherLang] : routes.home[otherLang];
const navKeys: RouteKey[] = ['home', 'research', 'about'];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      route && (
        <>
          <link rel="alternate" hreflang="ja" href={new URL(routes[route].ja, SITE_URL).href} />
          <link rel="alternate" hreflang="en" href={new URL(routes[route].en, SITE_URL).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(routes[route].ja, SITE_URL).href} />
        </>
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.orgName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, SITE_URL).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    {route && <meta property="og:locale:alternate" content={lang === 'ja' ? 'en_US' : 'ja_JP'} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#141821" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo-link" href={routes.home[lang]}>
          <img class="logo" src="/logo_original.png" alt={t.orgName} width="990" height="162" />
        </a>
        <nav class="site-nav" aria-label={lang === 'ja' ? 'サイト内' : 'Site'}>
          <ul>
            {
              navKeys.map((key) => (
                <li>
                  <a href={routes[key][lang]} aria-current={key === route ? 'page' : undefined}>
                    {t.nav[key]}
                  </a>
                </li>
              ))
            }
            <li class="lang-switch">
              <a href={switchHref} lang={otherLang} hreflang={otherLang}>{t.langSwitch}</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-org">{t.orgName}{lang === 'en' && ' (KMA)'}</p>
        <ul class="footer-links">
          <li><a href={CONTACT_FORM_URL} rel="noopener">{t.contact}</a></li>
          <li><a href={jaOnlyRoutes.koukoku} lang="ja" hreflang="ja">{t.koukoku}</a></li>
        </ul>
        <p class="copyright">&copy; {new Date().getFullYear()} {ui.en.orgName}</p>
      </div>
    </footer>
  </body>
</html>
